{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoovaStack Assessment Plan",
  "type": "object",
  "required": ["status", "scope_summary", "planned_steps", "blocked_actions", "human_review_required"],
  "properties": {
    "status": { "type": "string", "enum": ["READY", "BLOCKED", "NEEDS_APPROVAL"] },
    "scope_summary": { "type": "string" },
    "planned_steps": { "type": "array", "items": { "type": "string" } },
    "blocked_actions": { "type": "array", "items": { "type": "string" } },
    "missing_information": { "type": "array", "items": { "type": "string" } },
    "human_review_required": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
