      "first_observed": "21 July 2026, 07:07 UTC",
      "last_confirmed": "21 July 2026, 07:07 UTC",
      "priority_label": "Priority 1",
      "summary": "The assessed web service did not present one or more recommended browser security headers in the captured HTTP response evidence.",
      "technical_description": "The scan workflow reviewed HTTP response metadata and observed that recommended browser-enforced controls were absent. Expected behavior is to configure appropriate headers aligned to application requirements so browsers can enforce additional client-side protections.",
      "business_impact": "The available evidence supports a security-hardening concern; specific business impact was not provided.",
      "technical_impact": "Reduced browser-enforced protection against selected client-side attack techniques and content-handling risks.",
      "header_table": [
        {
          "header": "Content-Security-Policy",
          "observed": "Missing",
          "recommended": "Configure",
          "purpose": "Restricts where browser-executed content can load from and can control framing through frame-ancestors.",
          "notes": "Define an application-specific policy. Prefer frame-ancestors for modern frame-control enforcement."
        },
        {
          "header": "X-Content-Type-Options",
          "observed": "Missing",
          "recommended": "Configure",
          "purpose": "Reduces MIME-sniffing behavior that may cause browsers to interpret content unexpectedly.",
          "notes": "Common value: nosniff."
        },
        {
          "header": "Referrer-Policy",
          "observed": "Missing",
          "recommended": "Configure",
          "purpose": "Controls how much referrer information is sent to other origins.",
          "notes": "Common baseline: strict-origin-when-cross-origin, adjusted to application needs."
        },
        {
          "header": "Permissions-Policy",
          "observed": "Missing",
          "recommended": "Configure",
          "purpose": "Limits access to selected browser features and APIs.",
          "notes": "Disable features not required by the application."
        },
        {
          "header": "X-Frame-Options",
          "observed": "Missing",
          "recommended": "Configure",
          "purpose": "Provides legacy frame-control protection where CSP frame-ancestors is not used or for compatibility.",
          "notes": "May be retained for compatibility when appropriate; CSP frame-ancestors is generally preferred."
        }
      ],
      "service_table": [],
      "evidence": [
        {
          "evidence_id": "EVID-4889571D",
          "finding_id": "NST-WEB-001",
          "evidence_type": "Validated Observation",
          "summary": "The application response is missing security headers that help browsers block clickjacking, content injection, MIME sniffing, and privacy leaks.",
