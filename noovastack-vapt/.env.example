# NoovaStack VAPT Platform Environment Configuration
# Required. Set a strong unique password — never use the default in production.
POSTGRES_DB=noovastack_vapt
POSTGRES_USER=noovastack
POSTGRES_PASSWORD=
REDIS_PASSWORD=
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@postgres:5432/noovastack_vapt
DATABASE_URL_SYNC=postgresql://<db_user>:<db_password>@postgres:5432/noovastack_vapt
REDIS_URL=redis://:<redis_password>@redis:6379/0
CELERY_BROKER_URL=redis://:<redis_password>@redis:6379/1
CELERY_RESULT_BACKEND=redis://:<redis_password>@redis:6379/2
# Required. Generate with: openssl rand -hex 32
SECRET_KEY=
# Required only on first startup when the initial admin does not exist.
INITIAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=3600
RESULTS_DIR=/app/results
# Optional but recommended for higher NVD API rate limits.
NVD_API_KEY=
CVE_HTTP_TIMEOUT_SECONDS=45
CVE_STALE_AFTER_HOURS=4
# Unauthenticated NVD clients should remain at 6 seconds; API-key clients may lower this.
NVD_REQUEST_DELAY_SECONDS=6
# NoovaStack local AI provider (OpenAI-compatible):
AI_PROVIDER=noovastack-local
AI_BASE_URL=https://chat.noovastack.com/api
AI_API_KEY=replace-with-your-noovastack-local-token
AI_MODEL=qwen3.6-coder:35b-32k
AI_TIMEOUT_SECONDS=240
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
