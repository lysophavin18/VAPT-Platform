# NoovaStack VAPT Platform Environment Configuration
DATABASE_URL=postgresql+asyncpg://noovastack:noovastack_secure_2024!@postgres:5432/noovastack_vapt
REDIS_URL=redis://:noovastack_redis_2024!@redis:6379/0
CELERY_BROKER_URL=redis://:noovastack_redis_2024!@redis:6379/1
CELERY_RESULT_BACKEND=redis://:noovastack_redis_2024!@redis:6379/2
SECRET_KEY=change-this-to-a-secure-random-string-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=3600
RESULTS_DIR=/app/results
