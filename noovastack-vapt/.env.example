# NoovaStack VAPT Platform Environment Configuration
DATABASE_URL=postgresql+asyncpg://noovastack:noovastack_secure_2024!@postgres:5432/noovastack_vapt
REDIS_URL=redis://:noovastack_redis_2024!@redis:6379/0
CELERY_BROKER_URL=redis://:noovastack_redis_2024!@redis:6379/1
CELERY_RESULT_BACKEND=redis://:noovastack_redis_2024!@redis:6379/2
# Required. Generate with: openssl rand -hex 32
SECRET_KEY=
# Required only on first startup when the initial admin does not exist.
INITIAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=3600
RESULTS_DIR=/app/results
# AI provider (OpenAI-compatible). DeepSeek defaults:
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-deepseek-key
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=240
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
