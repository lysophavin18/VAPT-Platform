# VAPT Platform Environment Configuration
# Copy this file to .env and modify values as needed

# Database Configuration
POSTGRES_USER=vapt_user
POSTGRES_PASSWORD=VAPTSecure2024!
POSTGRES_DB=vapt_platform
DATABASE_URL=postgresql+asyncpg://vapt_user:VAPTSecure2024!@postgres:5432/vapt_platform

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
DEBUG=false
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1

# Flower Monitoring (Celery)
FLOWER_BASIC_AUTH=admin:FlowerAdmin2024!

# API Configuration
API_PREFIX=/api
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# Scan Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_SECONDS=3600
DEFAULT_SCAN_THREADS=10

# Report Configuration
REPORTS_DIR=/app/reports
MAX_REPORT_SIZE_MB=100

# Tool Timeouts (seconds)
NMAP_TIMEOUT=1800
NIKTO_TIMEOUT=3600
NUCLEI_TIMEOUT=1800
ZAP_TIMEOUT=3600
SQLMAP_TIMEOUT=3600
GOBUSTER_TIMEOUT=1800
KATANA_TIMEOUT=1200
WPSCAN_TIMEOUT=1800
HYDRA_TIMEOUT=3600
