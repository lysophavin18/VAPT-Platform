# VAPT Platform Environment Configuration
# Copy this file to .env and modify values for production

# Database Configuration
DB_PASSWORD=VaptSecure2024!
POSTGRES_DB=vapt_db
POSTGRES_USER=vapt_admin

# Redis Configuration
REDIS_PASSWORD=VaptRedis2024!

# JWT Configuration
SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# OWASP ZAP Configuration
ZAP_API_KEY=zap-api-key-2024

# Flower (Celery Monitor) Configuration
FLOWER_USER=admin
FLOWER_PASSWORD=admin123

# WPScan API Token (get from https://wpscan.com/)
WPSCAN_API_TOKEN=your-wpscan-api-token

# Default Admin User
ADMIN_EMAIL=admin@vapt.local
ADMIN_PASSWORD=AdminSecure2024!

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Scan Settings
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=3600
